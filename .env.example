ADMIN_REVALIDATE_KEY=

# ── 인스타 작업(scripts/insta) ──
# Codespaces에서는 이 파일을 복사하지 말고 레포 Settings → Secrets and variables → Codespaces에 같은 이름으로 넣는다(값은 여기 적지 않는다).
# 스크립트는 환경변수가 이미 있으면 .env.local을 읽지 않는다(Codespaces secrets만으로 동작).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ELEVENLABS_API_KEY=
